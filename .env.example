# Copy this file to .env.local and set real values before running Clarity365.
# .env.local is gitignored and must never be committed.
#
# The operator password itself is NOT set here - on first run, the app will prompt
# you to create one, and it's stored (hashed) in data/clarity-store.json. Change it
# any time from Settings > Change Operator Password once logged in.

# Random secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLARITY365_SESSION_SECRET=

# Passphrase used to derive the AES-256-GCM key that encrypts tenant client secrets
# at rest in data/clarity-store.json. Generate the same way as above. Changing this
# after tenants have been added will make existing encrypted secrets unreadable.
CLARITY365_ENCRYPTION_KEY=
